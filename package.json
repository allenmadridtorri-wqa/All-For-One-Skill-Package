{
  "name": "all-for-one-skill-package",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "bin": {
    "all-for-one": "./scripts/install.mjs",
    "afo": "./scripts/install.mjs"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "afo:validate": "tsx scripts/afo.ts validate",
    "afo:build": "tsx scripts/afo.ts build",
    "afo:sync": "tsx scripts/afo.ts sync",
    "afo:install": "node scripts/install.mjs --global",
    "afo:uninstall": "node scripts/install.mjs --uninstall --global",
    "afo:verify-install": "node scripts/install.mjs --verify --workspace",
    "afo:check-tools": "node scripts/install.mjs --check-tools",
    "afo:eval": "tsx scripts/afo.ts eval",
    "afo:eval:legacy": "tsx scripts/afo.ts eval-triggers",
    "afo:retrieve": "tsx scripts/afo.ts retrieve",
    "afo:models": "tsx scripts/afo.ts models --t4-only",
    "afo:mcp": "tsx scripts/mcp-bridge.ts",
    "afo:token-budget": "tsx scripts/afo.ts token-budget",
    "afo:qa": "tsx scripts/afo.ts qa-report",
    "afo:test": "tsx --test scripts/afo.test.ts scripts/v2-framework.test.ts scripts/v3-framework.test.ts scripts/v3_1-framework.test.ts scripts/v3_2-framework.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
